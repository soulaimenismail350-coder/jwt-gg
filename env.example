# Required: choose a long random value and send it as X-API-Key.
API_SECRET=replace-with-a-long-random-secret

# Required: each AES value must be exactly 16 bytes.
AES_KEY=replace-with-16-byte-key
AES_IV=replace-with-16-byte-iv

# Required: Garena client secret used by the original source.
GARENA_CLIENT_SECRET=replace-with-your-client-secret

# Optional
GAME_REGION=BD
DEVICE_NAME=OPPO PHM110
DEVICE_CPU=x86-64 SSE3 SSE4.1 SSE4.2 AVX
DEVICE_GPU=Adreno (TM) 750
DEVICE_MEM=3004
